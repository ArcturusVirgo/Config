{
    // 文件排除
    "files.exclude": {
        "**/.git": true,
        "**/.vscode": false,
        "**/*.i90": true,
        "**/*.mod": true,
        "**/*__genmod.f90": true,
    },


    "fortran.linter.extraArgs": [
        "-module:${workspaceFolder}/.vscode/.fortran_mod",
        "/nofpp"
    ],
    "fortran.linter.includePaths": [
        "${workspaceFolder}/.vscode/.fortran_mod"
    ],

}