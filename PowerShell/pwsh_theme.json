{
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#45F1C2",
          "style": "plain",
          "template": "{{ .UserName }} ",
          "type": "session"
        },
        {
          "foreground": "#0CA0D8",
          "style": "plain",
          "template": "{{ .Path }}",
          "type": "path",
          "properties": {
            "folder_separator_icon": "/",
            "style": "full"
          }
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "foreground": "#3CEC85",
          "style": "plain",
          "template": "py:{{ .Venv }}",
          "type": "python",
          "properties": {
            "display_mode": "environment"
          }
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground_templates": [
            "{{ if .Root }}#cd5e42{{ end }}",
            "{{ if not .Root }}#CD4277{{ end }}"
          ],
          "template": "{{ if .Root }}# {{ else }}$ {{ end }}"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 4
}